{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/checkushka/checkushka/master/schema/checkushka.schema.json",
  "title": "Конфигурация checkushka",
  "description": "Настройки проверки метаданных и форм конфигураций 1С",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": ["ru", "en"],
      "default": "ru",
      "description": "Язык сообщений"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": ["auto", "designer", "edt"],
          "default": "auto",
          "description": "Формат выгрузки конфигурации"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["ON", "OFF", "ONLY", "EXCEPT", "ALL"],
          "default": "ON",
          "description": "Режим включения проверок"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ключи проверок для режимов ONLY и EXCEPT"
        },
        "minSeverity": {
          "type": "string",
          "enum": ["BLOCKER", "CRITICAL", "MAJOR", "MINOR", "INFO"],
          "default": "INFO",
          "description": "Минимальная важность замечаний в отчёте"
        },
        "parameters": {
          "type": "object",
          "description": "Параметры проверок по ключу",
          "additionalProperties": {
            "type": "object"
          }
        },
        "severity": {
          "type": "object",
          "description": "Переопределение важности проверок по ключу",
          "additionalProperties": {
            "type": "string",
            "enum": ["BLOCKER", "CRITICAL", "MAJOR", "MINOR", "INFO"]
          }
        }
      }
    },
    "ignore": {
      "type": "array",
      "description": "Исключения замечаний",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check": {
            "type": "string",
            "description": "Ключ проверки; пустое значение — все проверки"
          },
          "mdo": {
            "type": "string",
            "description": "Шаблон ссылки на объект метаданных, поддерживает *"
          },
          "reason": {
            "type": "string",
            "description": "Причина исключения"
          }
        }
      }
    }
  }
}
